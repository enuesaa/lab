{% extends 'base.html.twig' %}

{% block title %}Memo index{% endblock %}

{% block body %}
    <h1>Memo index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for memo in memos %}
            <tr>
                <td>{{ memo.id }}</td>
                <td>{{ memo.title }}</td>
                <td>{{ memo.description }}</td>
                <td>{{ memo.createdAt ? memo.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ memo.updatedAt ? memo.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_memo_show', {'id': memo.id}) }}">show</a>
                    <a href="{{ path('app_memo_edit', {'id': memo.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_memo_new') }}">Create new</a>
{% endblock %}
