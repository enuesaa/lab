{% import _self as f %}

{% macro field(field, attr) %}
    <div>
        {{ form_label(field, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-gray-700'}}) }}
        {{ form_widget(field, {attr: (attr|default({}))|merge({
            class: 'block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-gray-900 focus:outline-none'
        })}) }}
        {% for error in field.vars.errors %}
            <p class="mt-1 text-sm text-red-600">{{ error.message }}</p>
        {% endfor %}
    </div>
{% endmacro %}

{{ form_start(form, {attr: {class: 'space-y-5 rounded-lg border border-gray-200 bg-white p-6'}}) }}
    {{ f.field(form.title) }}
    {{ f.field(form.description, {rows: 8}) }}
    {{ f.field(form.created_at) }}
    {{ f.field(form.updated_at) }}

    <div class="flex items-center gap-4 pt-2">
        <button class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
            {{ button_label|default('Save') }}
        </button>
        <a href="{{ path('app_home') }}" class="text-sm text-gray-600 hover:underline">Cancel</a>
    </div>
{{ form_end(form) }}
